# Copy this file to .env.local and fill in your tokens.
# Restart the Next.js dev server after editing.
# The NEXT_PUBLIC_ prefix exposes the variable to the browser.

# Mapbox — https://account.mapbox.com/access-tokens/
# Used for: Terrain-RGB elevation tiles, satellite imagery
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cesium Ion — https://cesium.com/ion/tokens
# Used for: (future) Cesium World Terrain, 3D Tiles, OSM Buildings
NEXT_PUBLIC_CESIUM_TOKEN=
